{
  "name": "data-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo run check-types",
    "vet": "turbo run lint check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:web": "pnpm --filter web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  }
}